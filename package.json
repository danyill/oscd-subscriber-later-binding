{
  "name": "@openpowershift/oscd-editor-subscriber-later-binding",
  "description": "Plugin for later-binding GOOSE and SMV subscriptions of IEC 61850 SCL files for OpenSCD",
  "license": "Apache-2.0",
  "author": "OpenPowerShift",
  "version": "0.8.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenPowerShift/oscd-editor-subscriber-later-binding.git"
  },
  "main": "dist/oscd-editor-subscriber-later-binding.js",
  "module": "dist/oscd-editor-subscriber-later-binding.js",
  "exports": {
    ".": "./dist/oscd-editor-subscriber-later-binding.js"
  },
  "scripts": {
    "clean": "node -e \"require(\\\"fs\\\").rmSync(\\\"dist\\\",{recursive:true,force:true})\"",
    "lint": "oscd lint",
    "format": "oscd lint --format",
    "start": "oscd start",
    "start:bundle": "oscd start-bundle",
    "build": "npm run clean && oscd build --no-clean",
    "bundle": "npm run clean && oscd bundle --no-clean",
    "test": "oscd test",
    "test:watch": "oscd test --watch",
    "test:visual": "oscd test --visual",
    "updates": "oscd updates",
    "deploy": "oscd deploy",
    "prepare": "oscd install-hooks",
    "pretest": "npm run clean",
    "pretest:visual": "npm run clean"
  },
  "dependencies": {
    "@lit-labs/virtualizer": "^2.1.1",
