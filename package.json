    "@openscd/oscd-api": "^0.1.6",
    "@openscd/scl-lib": "^2.0.1",
    "lit": "^3.3.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@fontsource/material-symbols-outlined": "^5.3.9",
